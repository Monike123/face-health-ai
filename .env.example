# Copy to .env locally. Never commit real secrets.
# FACEHEALTH_LOG_LEVEL=INFO
# FACEHEALTH_CONFIG=configs/config.yaml
# Private dataset URLs after author approval (do not commit real links if sensitive):
# FACEHEALTH_UBFC_URL=

# --- Web v0.1 (Clerk) ---
# Backend (root .env, loaded by: uvicorn ... --env-file .env)
CLERK_SECRET_KEY=
# Comma-separated origins allowed in Clerk session tokens (required on Vercel)
ALLOWED_ORIGINS=http://localhost:3000

# Frontend: put these two in web/.env.local
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
