# Copy to .env locally. Never commit real secrets.
# FACEHEALTH_LOG_LEVEL=INFO
# FACEHEALTH_CONFIG=configs/config.yaml

# --- Python API (local uvicorn) ---
# FACEHEALTH_DEV_AUTH=1   # local-only auth bypass; ignored when VERCEL=1
CLERK_SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:3000

# --- Web (web/.env.local) ---
