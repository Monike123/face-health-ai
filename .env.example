# Copy to .env locally. Never commit real secrets.
# FACEHEALTH_LOG_LEVEL=INFO
# FACEHEALTH_CONFIG=configs/config.yaml
# Private dataset URLs after author approval (do not commit real links if sensitive):
# FACEHEALTH_UBFC_URL=

# --- Web v0.1 ---
# Local demo (no Clerk). NEVER set either of these on Vercel.
FACEHEALTH_DEV_AUTH=1
# Frontend: put NEXT_PUBLIC_DEV_AUTH=1 in web/.env.local for the matching demo mode.

# Production / preview (Clerk) — leave DEV_AUTH unset/off
CLERK_SECRET_KEY=
# Comma-separated origins allowed in Clerk session tokens (required on Vercel)
ALLOWED_ORIGINS=http://localhost:3000
# Frontend (web/.env.local):
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

